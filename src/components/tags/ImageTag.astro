---
import { Image } from "astro:assets";

const { text, img, alt = "Logo" } = Astro.props;
---

<span
  class="inline-flex border px-2 text-center bg-gray-100 border-gray-200 rounded-sm text-sm h-5.5 justify-center items-center gap-1"
>
  <Image src={img} alt={alt} class="h-4 w-4 align-middle max-w-full" />
  {text}
</span>
