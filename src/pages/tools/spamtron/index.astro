---
import Footer from "../../../components/Footer.astro";
import Navbar from "../../../components/nav/Navbar.astro";
import Layout from "../../../layout/Layout.astro";

export const title = "SPAMTROM 888P+ Plus®";
export const description = "Easy test grader tool";
---

<Layout title="Spamtrom 888P+ Plus®" description="Easy test grader tool" metatitle="Spamtrom 888P+ Plus®">
    <Navbar />
    <main class="w-screen px-8 md:w-2xl gap-4 flex flex-col md:px-2">
        <div class="bg-[#f9faf4] px-2 py-1 border-2 italic border-gray-800 rounded-sm">
            <div class="text-red-600 font-bold text-2xl">SPAMTRON® 888P+</div>
            <div class="text-xl">TEST SCORING MACHINE</div>
        </div>
        <details open>
            <summary>1. Key</summary>
            <div id="key" class="flex flex-col">
                <div class="flex items-center">
                    <h2 class="text-2xl pr-2">1.</h2>
                    <div class="flex flex-col w-full">
                        <select name="type" id="type">
                            <option value="text">Type &mdash; Text</option>
                            <option value="subjective">Type &mdash; Subjective</option>
                        </select>
                        <input type="text" placeholder="Text">
                    </div>
                </div>
            </div>
        </details>
    </main>
    <Footer />
</Layout>

<script defer>
    function createKeyBox() {
        const container = document.createElement("div")
        container.classList.add(["flex", "items-center"])

        const numberheader = document.createElement("h2")
        numberheader.classList.add(["text-2xl, pr-2"])
        numberheader.textContent = "1."
        container.appendChild(numberheader)

        const datacontainer = document.createElement("div")
        datacontainer.classList.add(["flex", "flex-col", "w-full"])
        container.appendChild(datacontainer)
    }
</script>