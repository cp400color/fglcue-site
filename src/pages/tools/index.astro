---
import { Image } from "astro:assets";
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/nav/Navbar.astro";
import Layout from "../../layout/Layout.astro";
import ClueLogo from "../../assets/logobl.png";

const allPosts = Object.values(import.meta.glob("./*/**.astro", { eager: true }));
---

<Layout title="Tools · Clue", description="Some small tools", metaTitle="Tools - Clue">
  <Navbar />
  <main class="w-screen px-8 md:w-2xl gap-4 flex flex-col md:px-2">
    <div class="flex flex-col gap-8">
      <div class="px-2 my-0 py-0">
        <Image
          src={ClueLogo}
          alt="Clue Logo. Pixelated mirrored lower case T with missing bottom pixel."
          class="border-2 border-gray-300 aspect-square w-24 h-24 mb-4"
          loading="eager"
          width="144"
          height="144"
        />
      </div>
      <div class="px-2 my-0">
        <h1 class="text-2xl">Tools</h1>
        <p>Some simple tools</p>
      </div>
      <ol class="gap-1 py-0 my-0">
        {
          allPosts.map((post: any) => (
            <li class="flex flex-row gap-2 px-2 py-1 max-md:w-full hover:bg-gray-50">
              <a href={post.url} class="flex gap-2 max-md:w-full">
                <p class="max-md:w-full">{post.title}</p>
                <p class="max-md:w-full text-gray-600">{post.description}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </main>
</Layout>
<Footer />
