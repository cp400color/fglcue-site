---
import { Image } from "astro:assets";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";

import ClueLogo from "../assets/logobl.png";
import Tag from "../components/Tag.astro";
import InactiveTag from "../components/tags/InactiveTag.astro";
import ProjectBar from "../components/tags/ProjectBar.astro";
import LinkedTag from "../components/tags/LinkedTag.astro";
---

<Layout>
  <Navbar />
  <main class="md:w-2xl gap-4 flex flex-col px-2">
    <div class="flex flex-col gap-8">
      <div>
        <Image
          src={ClueLogo}
          alt="Clue Logo. Pixelated mirrored lower case T with missing bottom pixel."
          class="border-2 border-gray-300 aspect-square w-24 h-24"
          loading="eager"
          width="144"
          height="144"
        />
      </div>
      <div>
        <h1 class="text-2xl">Clue</h1>
        <p>
          I am a full-stack developer based in Brazil. Right now, I am working
          on developing software for my business biitle.nl. I've been developing
          software since around 2024.
        </p>
        <p class="text-gray-900 text-sm">Timezone: GMT-3 · Brasília Time</p>
      </div>
    </div>

    <div id="portfolio"></div>

    <div>
      <h1 class="text-2xl">Skills</h1>
      <p>
        I am familiar with <Tag text="Python" />, <Tag text="Rust" /> and <Tag
          text="Kotlin"
        />. Regarding the web, I am familiar with <Tag text="HTML" />, <Tag
          text="JavaScript"
        /> and <Tag text="TypeScript" />,
        <Tag text="CSS" /> and JSX-like frameworks such as <Tag text="React" /> and
        <Tag text="Astro" />.
      </p>
      <p>
        I also know how to use tools like <Tag text="Docker" />, <Tag
          text="Vite"
        />, <Tag text="Figma" />, <Tag text="Git" /> and <Tag
          text="Insomnia REST"
        />.
      </p>
    </div>

    <div>
      <h1 class="text-2xl">Projects</h1>
      <ProjectBar>
        Projects: 
        <Tag text="ppddvv" />
        <LinkedTag text="Podnative" url="https://biitle.nl/apps/podnative/" />
        <Tag text="Lightswitch for Toggl" />
      </ProjectBar>
      <ProjectBar>
        Experiments: 
        <LinkedTag text="Crossaint" url="https://github.com/fgclue2/Crossaint/" />
        <LinkedTag text="xkcd.sh" url="https://github.com/fgclue2/xkcd.sh/" />
      </ProjectBar>
      <ProjectBar>
        Open source: 
        <LinkedTag text="Espresso" url="https://github.com/fgclue/Espresso/" />
      </ProjectBar>
      <ProjectBar>
        Side-projects:
        <LinkedTag text="Storekit" url="https://github.com/fgclue/storekit/" />
      </ProjectBar>
      <ProjectBar>
        Inactive:
        <InactiveTag text="FluidServer" year="2025-2026" />
        <InactiveTag text="Outclock" year="2026" />
        <InactiveTag text="Jot" year="2026" />
      </ProjectBar>
    </div>
  </main>
  <Footer />
</Layout>
