---
import { Image } from "astro:assets";
import Footer from "../components/Footer.astro";
import Navbar from "../components/nav/Navbar.astro";
import Layout from "../layout/Layout.astro";

import ClueLogo from "../assets/logobl.png";
import Tag from "../components/Tag.astro";
import InactiveTag from "../components/tags/InactiveTag.astro";
import ProjectBar from "../components/tags/ProjectBar.astro";
import LinkedTag from "../components/tags/LinkedTag.astro";
import Link from "../components/Link.astro";
---

<Layout>
  <Navbar />
  <main class="w-screen px-8 md:w-2xl gap-4 flex flex-col md:px-2">
    <div class="flex flex-col gap-8">
      <div>
        <Image
          src={ClueLogo}
          alt="Clue Logo. Pixelated mirrored lower case T with missing bottom pixel."
          class="border-2 border-gray-300 aspect-square w-24 h-24"
          loading="eager"
          width="144"
          height="144"
        />
      </div>
      <div>
        <h1 class="text-2xl">Clue</h1>
        <p>Hey! It's me! Just a guy with some <Link href="/blog">blog posts</Link>, some <Link href="https://github.com/fgclue">projects</Link> and some <Link href="https://biitle.nl">web</Link><Link href="/">sites</Link></p>
        <p class="text-gray-900 text-sm">Timezone: GMT-3 · Brasília Time</p>
        <p class="text-gray-900 text-sm">Phone: Who still uses phones??</p>
        <p class="text-gray-900 text-sm">Electronic mail: Click on Contact above</p>
        <p class="text-gray-900 text-sm" id="favorite-thing">Favorite superlative: best</p>
      </div>
      <script defer>
        items = [
          "Favorite superlative: best",
          "Favorite CSS property: field-sizing",
          "Favorite programming language: Kotlin",
          "Favorite image file format: WEBP",
          "Favorite top level domain: .org",
          "Size of my .gradle folder: 9.5G",
          "Favorite filesystem: btrfs",
          "Favorite monospace font: Comic Code Ligatures",
          "Favorite sans-serif font: Inter",
          "Favorite round font: SF Pro Rounded",
          "Favorite source code license: MIT",
          "Code editors I have installed: 6",
          "Favorite task manager: Todoist",
          "Favorite color: 422nm",
          "Least favorite scripting language: Batch",
          "Favorite bodging program: AutoHotKey",
          "Favorite element: 119 Ununennium",
          "Favorite Unicode Character: ︘ PRESENTATION FORM FOR VERTICAL RIGHT WHITE LENTICULAR BRAKCET",
          "CPU Brand: AMD",
          "Favorite code contest: IOCCC",
          "Installed GNOME extensions: 15"
        ]
        document.getElementById("favorite-thing").textContent = items[items.length - 1 - Math.floor(Math.random() * items.length)]
      </script>
    </div>

    <div id="portfolio"></div>

    <div>
      <h1 class="text-2xl">Skills</h1>
      <p>
        I am familiar with <Tag text="Kotlin" />, <Tag text="Python" />, <Tag text="Rust" /> and also <Tag text="TypeScript" />. I am also trying to learn how to use <Tag text="C" /> and my <Link href="https://youtu.be/cFtymODJEjs">favorite interpreted langauge</Link>, <Tag text="C++" />.
      </p>
      <p>
        Also, I am familiar with tools such as <Tag text="Git" />, <Tag text="Docker" /> and <Tag text="Figma" />
      </p>
    </div>

    <div>
      <h1 class="text-2xl">Projects</h1>
      <ProjectBar>
        Projects: 
        <Tag text="ppddvv" />
        <LinkedTag text="Podnative" url="https://biitle.nl/apps/podnative/" />
        <LinkedTag text="Lightswitch for Toggl" url="https://biitle.nl/apps/lightswitch/" />
      </ProjectBar>
      <ProjectBar>
        Experiments: 
        <LinkedTag text="Crossaint" url="https://github.com/fgclue2/Crossaint/" />
        <LinkedTag text="xkcd.sh" url="https://github.com/fgclue2/xkcd.sh/" />
      </ProjectBar>
      <ProjectBar>
        Open source: 
        <LinkedTag text="Espresso" url="https://github.com/fgclue/Espresso/" />
      </ProjectBar>
      <ProjectBar>
        Side-projects:
        <LinkedTag text="Storekit" url="https://github.com/fgclue/storekit/" />
      </ProjectBar>
      <ProjectBar>
        Inactive:
        <InactiveTag text="FluidServer" year="2025-2026" />
        <InactiveTag text="Outclock" year="2026" />
        <InactiveTag text="Jot" year="2026" />
      </ProjectBar>
    </div>
  </main>
  <Footer />
</Layout>
